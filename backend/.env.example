# Local/native default is SQLite. For MySQL use:
# DATABASE_URL=mysql+pymysql://hms_user:hms_pass@localhost:3306/house_mgmt
DATABASE_URL=sqlite:///./house_management.db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Sales above this amount need admin approval before the employee can check out
APPROVAL_THRESHOLD=10000.00
PRODUCT_IMAGE_DIR=uploads/products
# Sign-in and audit rows older than this many days are deleted automatically
LOG_RETENTION_DAYS=7
# Telegram notifications for stock IN / OUT actions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ABA PayWay (QR / ABA Pay). Leave PAYWAY_ENABLED=false to hide the QR option.
# Sandbox: https://checkout-sandbox.payway.com.kh  Production: https://checkout.payway.com.kh
PAYWAY_ENABLED=false
PAYWAY_MERCHANT_ID=
# Use the short Public Key value from the PayWay credentials email (not an RSA key).
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Public HTTPS URL of POST /api/payments/payway/webhook (optional; the POS also polls).
PAYWAY_CALLBACK_URL=
PAYWAY_QR_LIFETIME_MINUTES=10
PAYWAY_QR_IMAGE_TEMPLATE=template3_color
# The app stores prices in USD; keep this as USD.
PAYWAY_CURRENCY=USD
# Built-in sandbox test payer (Operations -> ABA Simulator). Sandbox only.
PAYWAY_SIMULATOR_ENABLED=false
# First manager account (created by: python -m app.seed)
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=ChangeMe123!
SEED_MANAGER_NAME=Store Manager
