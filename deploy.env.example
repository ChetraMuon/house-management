# Copy this file to .env (same folder as docker-compose.yml) before deploying.
# Never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-string
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PASSWORD=replace-me

SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=replace-me

PAYWAY_ENABLED=true
PAYWAY_MERCHANT_ID=your_sandbox_merchant_id
PAYWAY_API_KEY=your_sandbox_public_key
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CALLBACK_URL=https://your-domain.com/api/payments/payway/webhook
PAYWAY_QR_LIFETIME_MINUTES=30
PAYWAY_CURRENCY=USD

# Comma-separated origins allowed to call the API from another origin.
CORS_ORIGINS=http://localhost:5173
